<!DOCTYPE html>
<html lang="pt-BR" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Ofício Geral{% endblock %} — DPU</title>

    <!-- Tailwind + DaisyUI via CDN -->
    <link href="https://cdn.jsdelivr.net/npm/daisyui@4.12.23/dist/full.min.css" rel="stylesheet" type="text/css" />
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- HTMX + Alpine.js -->
    <script src="https://unpkg.com/htmx.org@2.0.4"></script>
    <script src="https://unpkg.com/htmx-ext-sse@2.2.2/sse.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.14.8/dist/cdn.min.js"></script>

    <style>
        /* Sidebar fixa no desktop */
        .sidebar { width: 260px; min-height: 100vh; }
        .main-content { margin-left: 260px; }
        @media (max-width: 768px) {
            .sidebar { width: 100%; min-height: auto; position: relative; }
            .main-content { margin-left: 0; }
        }

        /* Badge de classificacao */
        .badge-classif { font-size: 0.7rem; letter-spacing: 0.03em; }

        /* Toast container */
        .toast-container {
            position: fixed; bottom: 1.5rem; right: 1.5rem; z-index: 9999;
            display: flex; flex-direction: column; gap: 0.5rem;
        }

        /* HTMX loading indicator */
        .htmx-indicator { display: none; }
        .htmx-request .htmx-indicator { display: inline-block; }

        /* Alpine cloak */
        [x-cloak] { display: none !important; }
    </style>

    {% block head %}{% endblock %}
</head>
<body class="bg-base-300 text-base-content min-h-screen flex">

    <!-- Sidebar -->
    <aside class="sidebar bg-base-200 border-r border-base-300 flex flex-col fixed top-0 left-0 z-40">
        <!-- Header -->
        <div class="p-5 border-b border-base-300">
            <h1 class="text-xl font-bold text-primary">Ofício Geral</h1>
            <p class="text-xs text-base-content/60 mt-1">{{ oficio_descricao }}</p>
        </div>

        <!-- Nav -->
        {% set _cfg = get_painel_config() %}
        <nav class="flex-1 p-3">
            <ul class="menu menu-sm">
                <li>
                    <a href="/"
                       class="{% if request.url.path == '/' %}active{% endif %}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-2.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                        </svg>
                        PAJs
                    </a>
                </li>
                <li>
                    {% if _cfg.download_prazos %}
                    <a href="/prazos"
                       class="{% if request.url.path == '/prazos' %}active{% endif %}">
                    {% else %}
                    <a href="#"
                       class="opacity-40 cursor-not-allowed pointer-events-none"
                       title="Desativado nas Configurações do Painel">
                    {% endif %}
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                        </svg>
                        Prazos{% if not _cfg.download_prazos %} <span class="text-xs">(desativado)</span>{% endif %}
                    </a>
                </li>
                <li>
                    <a href="/watchlist"
                       class="{% if request.url.path == '/watchlist' %}active{% endif %}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z" />
                        </svg>
                        Watchlist
                    </a>
                </li>
                <li>
                    <a href="/pipeline"
                       class="{% if request.url.path == '/pipeline' %}active{% endif %}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 0 0 6 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0 1 18 16.5h-2.25m-7.5 0h7.5m-7.5 0-1 3m8.5-3 1 3m0 0 .5 1.5m-.5-1.5h-9.5m0 0-.5 1.5m.75-9 3-3 2.148 2.148A12.061 12.061 0 0 1 16.5 7.605" />
                        </svg>
                        Pipeline
                    </a>
                </li>
                <li>
                    <a href="/configuracoes"
                       class="{% if request.url.path == '/configuracoes' %}active{% endif %}">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                        </svg>
                        Configurações
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Footer -->
        <div class="p-4 border-t border-base-300 text-xs text-base-content/40">
            <p>Defensoria Pública da União</p>
            <p class="mt-1">v{{ app_version }}</p>
        </div>
    </aside>

    <!-- Main content -->
    <main class="main-content flex-1 min-h-screen flex flex-col">
        <div class="{% block content_class %}p-6 lg:p-8 max-w-7xl{% endblock %} flex-1">
            {% block content %}{% endblock %}
        </div>
    </main>

    <!-- Toast container -->
    <div class="toast-container" id="toast-container"></div>

    <!-- Pipeline modal (compartilhado) -->
    {% include "partials/pipeline_modal.html" %}

    <!-- Busca global (Ctrl+K) -->
    <dialog id="busca-modal" class="modal">
        <div class="modal-box w-11/12 max-w-3xl p-0">
            <div class="p-3 border-b border-base-300">
                <input type="text" id="busca-input"
                       class="input input-bordered w-full"
                       placeholder="Buscar em todo o acervo (Esc fecha, &uarr;&darr; navega, Enter abre)..."
                       autocomplete="off" />
                <div class="text-xs text-base-content/50 mt-2 flex items-center gap-3">
                    <span id="busca-status">digite pelo menos 2 caracteres</span>
                    <span class="text-base-content/30" id="busca-count"></span>
                </div>
            </div>
            <div id="busca-results" class="max-h-96 overflow-y-auto"></div>
        </div>
        <form method="dialog" class="modal-backdrop"><button>fechar</button></form>
    </dialog>

    <!-- Modal de Resumo (global — funciona em qualquer pagina) -->
    <dialog id="resumo-modal" class="modal">
        <div class="modal-box w-11/12 max-w-4xl">
            <div class="flex items-center justify-between mb-4">
                <h3 class="font-bold text-lg">
                    Resumo da elaboração — PAJ <span id="resumo-paj-label" class="font-mono"></span>
                </h3>
                <div class="flex gap-2">
                    <a id="resumo-abrir-paj" href="#" class="btn btn-sm btn-ghost">Abrir PAJ</a>
                    <form method="dialog"><button class="btn btn-sm btn-ghost">X</button></form>
                </div>
            </div>

            <!-- Conteudo (preenchido via JS) -->
            <div id="resumo-content" class="prose prose-sm prose-invert max-w-none whitespace-pre-wrap text-sm bg-base-300 p-4 rounded-lg max-h-[60vh] overflow-y-auto mb-4"></div>

            <!-- Discordar / Corrigir -->
            <div class="collapse collapse-arrow bg-base-200 border border-base-300">
                <input type="checkbox" id="discordar-toggle" />
                <div class="collapse-title text-sm font-semibold">
                    Discordar ou pedir correção
                </div>
                <div class="collapse-content">
                    <textarea id="correcao-text"
                              class="textarea textarea-bordered w-full text-sm"
                              rows="4"
                              placeholder="Ex: Na verdade cabem embargos de declaração porque houve omissão sobre X. Refaça como ED."></textarea>
                    <div class="flex justify-end gap-2 mt-2">
                        <button class="btn btn-sm btn-primary"
                                onclick="enviarCorrecaoAtual()">
                            Enviar correção e refazer
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop"><button>fechar</button></form>
    </dialog>

    <!-- Modal de Correção direta (sem passar pelo resumo) -->
    <dialog id="correcao-direta-modal" class="modal">
        <div class="modal-box w-11/12 max-w-3xl">
            <div class="flex items-center justify-between mb-3">
                <h3 class="font-bold text-lg">
                    Pedir correção / nova explicação — PAJ
                    <span id="correcao-direta-paj-label" class="font-mono"></span>
                </h3>
                <form method="dialog"><button class="btn btn-sm btn-ghost">X</button></form>
            </div>
            <p class="text-xs text-base-content/60 mb-2" id="correcao-direta-contexto"></p>
            <textarea id="correcao-direta-text"
                      class="textarea textarea-bordered w-full text-sm"
                      rows="6"
                      placeholder="Ex: Refaça o despacho sem citar o art. X. / Acrescente fundamento sobre Y. / Ajuste o tom e seja mais objetivo."></textarea>
            <div class="flex justify-end gap-2 mt-3">
                <form method="dialog"><button class="btn btn-sm btn-ghost">Cancelar</button></form>
                <button class="btn btn-sm btn-primary"
                        onclick="enviarCorrecaoDireta()">
                    Enviar correção e refazer
                </button>
            </div>
        </div>
        <form method="dialog" class="modal-backdrop"><button>fechar</button></form>
    </dialog>

    <script src="/static/js/app.js?v={{ app_version }}"></script>
    {% block scripts %}{% endblock %}
</body>
</html>
